[Unit]
Description=Re-render the site's AI token row after a laptop upload

[Service]
Type=oneshot
User=www-data
Group=www-data
StateDirectory=eduard-social-stats
ExecStart=/usr/bin/python3 /usr/local/lib/eduard-site/update-social-stats.py --render-only --html /var/www/eduardkhamzin.ru/index.html --cache /var/lib/eduard-social-stats/stats.json --tokens /var/lib/eduard-ai-tokens/tokens.json
TimeoutStartSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/www/eduardkhamzin.ru /var/lib/eduard-social-stats
